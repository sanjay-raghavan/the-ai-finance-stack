# QBO Bundled MCP — credentials template
# ==========================================
# Copy this file to .env (in this same directory) and fill in your values.
# Never commit .env to git — it's in .gitignore.
#
# These come from your Intuit Developer dashboard:
#   https://developer.intuit.com/app/developer/myapps

# REQUIRED — from your Intuit app's "Keys & OAuth" tab
QBO_CLIENT_ID=your_client_id_here
QBO_CLIENT_SECRET=your_client_secret_here

# REQUIRED — environment: "production" or "sandbox"
# v0.1 of the Stack defaults to "production" (read-only is safe).
# Sandbox is useful if you want to test against Intuit's fake books before going live.
QBO_ENVIRONMENT=production

# REQUIRED — must match the redirect URI registered in your Intuit app
# For local-only use, the default below is fine; just register the same URI
# in your Intuit app's "Redirect URIs" list.
QBO_REDIRECT_URI=http://localhost:8765/callback

# OPTIONAL — overrides the default credential storage location
# Refresh tokens persist here; this file is gitignored automatically.
# Default: ~/.config/finance-stack/credentials/qbo.json
# QBO_CREDS_PATH=/custom/path/to/qbo.json

# OPTIONAL — log level for the MCP server (DEBUG / INFO / WARNING / ERROR)
QBO_LOG_LEVEL=INFO
